<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Trees for the instrumented tests. Off until a test enables it; it shares the app's UID, so the app reads
             it without a grant. A DocumentsProvider must be exported, grant URI permissions and require
             MANAGE_DOCUMENTS. -->
        <provider
            android:name=".storage.TestDocumentsProvider"
            android:authorities="io.github.ilyalissoboi.goosestation.testdocuments"
            android:enabled="false"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
