<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CharacterSet>NotSet</CharacterSet> <!-- TODO: Change to Unicode -->
    <!-- The toolset of the Visual Studio building: v145 from 2026 (18.0) on, else 2022's v143. -->
    <PlatformToolset Condition="!$(Configuration.Contains(Clang)) and $([MSBuild]::VersionGreaterThanOrEquals('$(VisualStudioVersion)', '18.0'))">v145</PlatformToolset>
    <PlatformToolset Condition="!$(Configuration.Contains(Clang)) and !$([MSBuild]::VersionGreaterThanOrEquals('$(VisualStudioVersion)', '18.0'))">v143</PlatformToolset>
    <PlatformToolset Condition="$(Configuration.Contains(Clang))">ClangCL</PlatformToolset>
    <SpectreMitigation>false</SpectreMitigation>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains(Debug))">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="!$(Configuration.Contains(Debug))">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
</Project>
