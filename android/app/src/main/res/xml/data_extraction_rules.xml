<!--
  Memory card sync's data (the working copy's emusync/) is this device's sync identity and the storage's unlocked key:
  a copy on another phone would make it this device, and two devices with one identity overwrite each other's saves.
  It never leaves the device, by backup or by device-to-device transfer, which android:allowBackup="false" doesn't
  stop from Android 12 on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="data/emusync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="data/emusync/" />
    </device-transfer>
</data-extraction-rules>
