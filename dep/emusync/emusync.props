<?xml version="1.0" encoding="utf-8"?>
<!--
  Memory card sync (src/core/memcard_sync.h) with emusync. The core loads emusync.dll at run time and
  builds against the vendored header (include/emusync.h), so this only puts the DLL next to the
  program: from a pinned release, emusync-X.Y.Z-windows-x64.zip or emusync-X.Y.Z-windows-arm64.zip by
  the platform (for duckstation-qt only), checked against its SHA-256 from the release's SHA256SUMS
  and unpacked into dep\msvc\. Without it (offline, /p:EmuSync=false, or another platform) the
  program runs without memory card sync.

  Use a package built from emusync's source (scripts/build-desktop.sh) with /p:EmuSyncDir=<package>\.
  Keep EmuSyncVersion in step with README.md here and CMakeModules/EmuSync.cmake.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EmuSyncVersion>0.3.1</EmuSyncVersion>
    <EmuSyncPackage Condition="'$(Platform)' == 'x64'">windows-x64</EmuSyncPackage>
    <EmuSyncSha256 Condition="'$(Platform)' == 'x64'">7f088e58d429da68cb3f608d187347e5004d288c9554064882877a64505bc2f5</EmuSyncSha256>
    <EmuSyncPackage Condition="'$(Platform)' == 'ARM64'">windows-arm64</EmuSyncPackage>
    <EmuSyncSha256 Condition="'$(Platform)' == 'ARM64'">e37a246081cd34570366952ff2fd92213337158d78e8d642c236544ed04472b4</EmuSyncSha256>
    <EmuSync Condition="'$(EmuSync)' == '' and '$(EmuSyncPackage)' != '' and '$(MSBuildProjectName)' == 'duckstation-qt'">true</EmuSync>
    <EmuSyncDir Condition="'$(EmuSyncDir)' == ''">$(MSBuildThisFileDirectory)..\msvc\emusync-$(EmuSyncVersion)-$(EmuSyncPackage)\</EmuSyncDir>
  </PropertyGroup>

  <Target Name="EmuSyncFetch" BeforeTargets="PrepareForBuild"
          Condition="'$(EmuSync)' == 'true' and !Exists('$(EmuSyncDir)bin\emusync.dll')">
    <PropertyGroup>
      <EmuSyncZipName>emusync-$(EmuSyncVersion)-$(EmuSyncPackage).zip</EmuSyncZipName>
      <EmuSyncDownloadDir>$(MSBuildThisFileDirectory)..\msvc\</EmuSyncDownloadDir>
      <EmuSyncZip>$(EmuSyncDownloadDir)$(EmuSyncZipName)</EmuSyncZip>
    </PropertyGroup>
    <Message Importance="high" Text="emusync: downloading $(EmuSyncZipName) for memory card sync" />
    <DownloadFile SourceUrl="https://github.com/ilyalissoboi/emusync/releases/download/v$(EmuSyncVersion)/$(EmuSyncZipName)"
                  DestinationFolder="$(EmuSyncDownloadDir)" ContinueOnError="WarnAndContinue" />
    <GetFileHash Condition="Exists('$(EmuSyncZip)')" Files="$(EmuSyncZip)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="EmuSyncZipSha256" />
    </GetFileHash>
    <!-- MSBuild compares strings case-insensitively, as hex digests should be. A download that isn't
         the pinned release is an error, not a reason to build without sync. -->
    <Error Condition="Exists('$(EmuSyncZip)') and '$(EmuSyncZipSha256)' != '$(EmuSyncSha256)'"
           Text="emusync: $(EmuSyncZipName) has SHA-256 $(EmuSyncZipSha256), expected $(EmuSyncSha256)" />
    <Unzip Condition="Exists('$(EmuSyncZip)')" SourceFiles="$(EmuSyncZip)" DestinationFolder="$(EmuSyncDir)" />
  </Target>

  <Target Name="EmuSyncCopyRuntime" AfterTargets="Build"
          Condition="'$(EmuSync)' == 'true' and Exists('$(EmuSyncDir)bin\emusync.dll')">
    <Copy SourceFiles="$(EmuSyncDir)bin\emusync.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
